{
  "name": "principle-driven-development",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run check",
    "check": "npm run catalog:check && npm run principles:check && npm run test:catalog && npm run test:cli",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "principles:check": "node packages/cli/src/cli.mjs check",
    "pdd": "node packages/cli/src/cli.mjs",
    "test:catalog": "node --test scripts/test/*.test.mjs",
    "test:cli": "node --test packages/cli/test/*.test.mjs"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  }
}
