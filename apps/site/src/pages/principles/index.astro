---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrincipleCard from '../../components/PrincipleCard.astro';
import { byOrder } from '../../lib/principles';
const principles = (await getCollection('principles')).sort(byOrder);
const categories = [...new Set(principles.map((item) => item.data.category))];

// PDD-01@v1: Catalog cards state the benefit of each rule.
// PDD-05@v1: The catalog links adoption to indexes, comments, reviews, and CLI checks.
// PDD-06@v1: The catalog lists only the currently published principles.
const toc = [{ id: 'available-principles', text: 'Available principles' }, { id: 'adopt-a-rule', text: 'Adopt a rule' }];
---

<BaseLayout title="Engineering Principle Catalog" description="Download engineering principles for software development with people and coding agents." schemaType="CollectionPage" section="Principle catalog" sourcePath="apps/site/src/pages/principles/index.astro" toc={toc} previous={{ title: 'CLI', href: '/cli' }} next={{ title: principles[0].data.title, href: `/principles/${principles[0].id}` }}>
  <h1>Principle catalog</h1>
  <p class="doc-lead">Start with useful examples of judgment that your codebase can earn.</p>
  <p>Each page helps you recognize a costly behavior and understand the corrective rule. Its download contains the compact agent file.</p>
  <p>These are candidates for adoption. They do not govern your repository until you adopt them under its own protocol.</p>
  <div class="page-actions"><a class="button" href="/principles/download.md" download="pdd-principles.md">Download catalog as Markdown <span aria-hidden="true">↓</span></a><a class="button" href="/example">See a rule in use</a></div>

  <h2 id="available-principles">Available principles</h2>
  <div class="catalog-filters" role="group" aria-label="Filter principles by category">
    <button type="button" data-category-filter="All" aria-pressed="true">All</button>
    {categories.map((category) => <button type="button" data-category-filter={category} aria-pressed="false">{category}</button>)}
  </div>
  <p class="catalog-count" role="status" data-catalog-count>{principles.length} principles</p>
  <div class="principle-grid">{principles.map((principle) => <PrincipleCard principle={principle} />)}</div>

  <h2 id="adopt-a-rule">Adopt a rule</h2>
  <p>Each principle needs repository evidence and a decision that it changes. Start with the rules that your codebase has earned.</p>
  <p>The combined download is a reading copy. For adoption, download the Markdown from each chosen principle's own page.</p>
  <ol>
    <li>Read every current principle in your repository.</li>
    <li>If a current rule covers the decision, use that rule or advance its version.</li>
    <li>For an independent recurring choice, adapt the <strong>Rule</strong> and its exceptions to your codebase.</li>
    <li>Record local evidence in a short <strong>Rationale</strong>.</li>
    <li>Follow your repository's admission protocol before adding a token.</li>
    <li>Choose a token that your repository has never used.</li>
    <li>If the token changes, update the heading, <code>Token</code> header, filename, and example citations together.</li>
    <li>Save one definition per file in your configured principle directory.</li>
    <li>Record your adoption in the dated <code>History</code> section.</li>
    <li>Add the current pin and file path to your agent index.</li>
    <li>Cite the pin where code or review decisions depend on the rule.</li>
    <li>Run <code>pdd check</code>.</li>
    <li>Add the check to CI.</li>
  </ol>
  <p><a href="/blueprint">The setup guide</a> supplies the review rules and explains each part. <a href="/cli#configuration">CLI configuration</a> defines your prefix, principle directory, and agent indexes.</p>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-principle-card]')];
  const count = document.querySelector('[data-catalog-count]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const category = button.dataset.categoryFilter;
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    let visible = 0;
    cards.forEach((card) => {
      card.hidden = category !== 'All' && card.dataset.category !== category;
      if (!card.hidden) visible++;
    });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'principle' : 'principles'}`;
  }));
</script>
