---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrincipleCard from '../../components/PrincipleCard.astro';
import { byOrder } from '../../lib/principles';
const principles = (await getCollection('principles')).sort(byOrder);
const categories = [...new Set(principles.map((item) => item.data.category))];

// SITE-01@v1: Catalog cards state the benefit of each rule.
// SITE-05@v1: The catalog links adoption to indexes, comments, reviews, and CLI checks.
// SITE-06@v1: The catalog lists only the currently published principles.
const toc = [{ id: 'available-principles', text: 'Available principles' }, { id: 'adopt-a-rule', text: 'Adopt a rule' }];
---

<BaseLayout title="Engineering Principle Catalog" description="Download engineering principles for software development with people and coding agents." schemaType="CollectionPage" section="Principle catalog" sourcePath="apps/site/src/pages/principles/index.astro" toc={toc} previous={{ title: 'CLI', href: '/cli' }} next={{ title: principles[0].data.title, href: `/principles/${principles[0].id}` }}>
  <h1>Principle catalog</h1>
  <p class="doc-lead">Start with useful examples of judgment that your codebase can earn.</p>
  <p>Each entry explains the rule, its benefit, the costly failure, and its exceptions. Adopt only the judgment that fits your repository.</p>
  <div class="page-actions"><a class="button" href="/principles/download.md" download>Download all as Markdown <span aria-hidden="true">↓</span></a><a class="button" href="/example">See a rule in use</a></div>

  <h2 id="available-principles">Available principles</h2>
  <div class="catalog-filters" role="group" aria-label="Filter principles by category">
    <button type="button" data-category-filter="All" aria-pressed="true">All</button>
    {categories.map((category) => <button type="button" data-category-filter={category} aria-pressed="false">{category}</button>)}
  </div>
  <p class="catalog-count" role="status" data-catalog-count>{principles.length} principles</p>
  <div class="principle-grid">{principles.map((principle) => <PrincipleCard principle={principle} />)}</div>

  <h2 id="adopt-a-rule">Adopt a rule</h2>
  <p>Adapt the rule, benefit, costly failure, effects, exceptions, and token to your codebase. Each principle needs evidence and a decision that it changes.</p>
  <p>Then connect the rule to the agent index, code comments, reviews, and CLI check. <a href="/blueprint">The setup guide</a> explains each part.</p>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-principle-card]')];
  const count = document.querySelector('[data-catalog-count]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const category = button.dataset.categoryFilter;
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    let visible = 0;
    cards.forEach((card) => {
      card.hidden = category !== 'All' && card.dataset.category !== category;
      if (!card.hidden) visible++;
    });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'principle' : 'principles'}`;
  }));
</script>
