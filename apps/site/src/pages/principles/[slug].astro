---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrincipleFile from '../../components/PrincipleFile.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { byOrder, type Principle } from '../../lib/principles';
import type { DocLink } from '../../lib/navigation';
import { siteConfig } from '../../../site.config.mjs';

export async function getStaticPaths() {
  return (await getCollection('principles')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: Principle; }
const { entry } = Astro.props;
const installCommand = `npx --yes @principle-driven/cli@0.2.1 add ${entry.id}`;
const whyParagraphs = entry.data.prevents.trim().split(/\n\s*\n/);
const principles = (await getCollection('principles')).sort(byOrder);
const currentIndex = principles.findIndex((item) => item.id === entry.id);
const toLink = (principle: Principle): DocLink => ({ title: principle.data.title, href: `/principles/${principle.id}` });
const previous = currentIndex > 0 ? toLink(principles[currentIndex - 1]) : { title: 'Principle catalog', href: '/principles' };
const next = currentIndex < principles.length - 1 ? toLink(principles[currentIndex + 1]) : { title: 'Set up your repository', href: '/blueprint' };
const hasCredits = entry.id === 'simplified-technical-english';
const toc = [
  { id: 'why', text: 'Why' },
  { id: 'installation', text: 'Installation' },
  ...(hasCredits ? [{ id: 'credits', text: 'Credits' }] : []),
];
const publishedDate = entry.data.published.toISOString().slice(0, 10);
const modifiedDate = entry.data.updated.toISOString().slice(0, 10);
// PDD-01@v1: Each detail page leads with its benefit.
// PDD-02@v1: Each detail page exposes the repeated behavior that the rule prevents.
// PDD-05@v1: Shared navigation links each rule to repository setup and CLI checks.
---

<BaseLayout title={entry.data.title} description={entry.data.summary} schemaType="TechArticle" publishedDate={publishedDate} modifiedDate={modifiedDate} articleSection={entry.data.category} alternateMarkdown={`/principles/${entry.id}.md`} section="Principles" toc={toc} previous={previous} next={next} sourcePath={`catalog/principles/${entry.id}.md`} sourceRepository={siteConfig.toolkitRepository} breadcrumbs={[
  { name: 'Home', path: '/' }, { name: 'Principles', path: '/principles' }, { name: entry.data.title, path: `/principles/${entry.id}` },
]}>
  <div class="principle-meta"><span class="token">{entry.data.token}</span><span>{entry.data.category}</span></div>
  <h1>{entry.data.title}</h1>
  <p class="doc-lead">{entry.data.benefit}</p>
  <h2 id="why">Why</h2>
  {whyParagraphs.map((paragraph) => <p data-principle-why>{paragraph}</p>)}

  <h2 id="installation">Installation</h2>
  <div data-install-command={installCommand}><CodeBlock code={installCommand} lang="shell" /></div>
  <p>The CLI uses your prefix, assigns the next local number, and updates your agent index. <a href="/cli#add-a-principle">CLI installation guide ↗</a></p>
  <p>The Markdown preview uses the catalog token. Your installed file uses its local token.</p>
  <PrincipleFile entry={entry} />

  {hasCredits && <>
    <h2 id="credits">Credits</h2>
    {entry.data.reference && <p class="further-reading">Based on <a href={entry.data.reference}>{entry.data.referenceTitle} ↗</a>.</p>}
    {entry.data.companionSkill && <p class="further-reading"><a href={entry.data.companionSkill.url}>{entry.data.companionSkill.name} skill ↗</a> can help agents apply this rule. The skill is optional.</p>}
  </>}
</BaseLayout>

<style>
  .further-reading { color: var(--muted); font-size: 12px; }
</style>
