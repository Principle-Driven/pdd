---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getCollection } from 'astro:content';
import { byOrder } from '../lib/principles';
import { getNavigation, type DocLink, type TocItem } from '../lib/navigation';
import { siteConfig } from '../../site.config.mjs';
import '../styles/global.css';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  schemaType?: 'WebPage' | 'AboutPage' | 'CollectionPage' | 'TechArticle';
  publishedDate?: string;
  modifiedDate?: string;
  articleSection?: string;
  alternateMarkdown?: string;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  section?: string;
  toc?: TocItem[];
  previous?: DocLink;
  next?: DocLink;
  sourcePath?: string;
}

const {
  title,
  description,
  image = siteConfig.socialImage,
  imageAlt = siteConfig.socialImageAlt,
  schemaType = 'WebPage',
  publishedDate,
  modifiedDate = publishedDate,
  articleSection,
  alternateMarkdown,
  breadcrumbs = [],
  noindex = false,
  section = 'Documentation',
  toc = [],
  previous,
  next,
  sourcePath = `apps/site/src/pages/${Astro.url.pathname === '/' ? 'index' : Astro.url.pathname.slice(1)}.astro`,
} = Astro.props;

const groups = getNavigation((await getCollection('principles')).sort(byOrder));
const sourceURL = `${siteConfig.repository}/blob/main/${sourcePath}`;

const siteURL = Astro.site ?? new URL(siteConfig.url);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);
const markdownURL = alternateMarkdown ? new URL(alternateMarkdown, siteURL) : undefined;
const pageTitle = title === siteConfig.name ? siteConfig.homeTitle : `${title} | ${siteConfig.name}`;
const organizationId = new URL('/#organization', siteURL).href;
const websiteId = new URL('/#website', siteURL).href;
const webpageId = `${canonicalURL.href}#webpage`;
const breadcrumbId = `${canonicalURL.href}#breadcrumb`;

const pageSchema = {
  '@type': schemaType,
  '@id': webpageId,
  url: canonicalURL.href,
  name: pageTitle,
  description,
  inLanguage: siteConfig.language,
  isPartOf: { '@id': websiteId },
  publisher: { '@id': organizationId },
  image: imageURL.href,
  license: siteConfig.licenseURL,
  ...(schemaType === 'TechArticle' && {
    headline: title,
    mainEntityOfPage: { '@id': webpageId },
    author: { '@id': organizationId },
    datePublished: publishedDate,
    dateModified: modifiedDate,
    articleSection,
  }),
  ...(breadcrumbs.length > 0 && { breadcrumb: { '@id': breadcrumbId } }),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: siteConfig.publisher,
      url: siteURL.href,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon-512.png', siteURL).href,
        width: 512,
        height: 512,
      },
      sameAs: [siteConfig.repository],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteURL.href,
      name: siteConfig.name,
      alternateName: siteConfig.shortName,
      description: siteConfig.description,
      inLanguage: siteConfig.language,
      publisher: { '@id': organizationId },
    },
    pageSchema,
    ...(breadcrumbs.length > 0 ? [{
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, siteURL).href,
      })),
    }] : []),
  ],
};

const structuredDataJSON = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.publisher} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('pdd-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {markdownURL && <link rel="alternate" type="text/markdown" href={markdownURL} title={`${title} as Markdown`} />}
    <meta property="og:type" content={schemaType === 'TechArticle' ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={structuredDataJSON} is:inline />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header groups={groups} />
    <div class="docs-shell">
      <aside class="site-sidebar"><Sidebar groups={groups} /></aside>
      <main id="main-content" tabindex="-1">
        <div class="page-breadcrumb"><a href="/">Docs</a><span aria-hidden="true">/</span><span>{section}</span></div>
        <article class="doc-content" data-doc-content><slot /></article>
        <Footer previous={previous} next={next} />
      </main>
      <TableOfContents items={toc} sourceURL={sourceURL} />
    </div>
  </body>
</html>
