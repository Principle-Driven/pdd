---
import type { Principle } from '../lib/principles';
interface Props { principle: Principle; }
const { principle } = Astro.props;
const { token, title, benefit, category } = principle.data;
---
<article class="principle-card" data-principle-card data-category={category}>
  <a class="card-link" href={`/principles/${principle.id}`} aria-label={`Read ${title}`}>
    <span class="card-token">{token}</span>
    <h3>{title}</h3>
    <p>{benefit}</p>
    <span class="card-category"><span>{category}</span><span aria-hidden="true">↗</span></span>
  </a>
</article>
