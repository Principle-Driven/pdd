---
import type { NavigationGroup } from '../lib/navigation';
interface Props { groups: NavigationGroup[]; }
const { groups } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav class="docs-navigation" aria-label="Documentation">
  {groups.map((group) => (
    <div class="navigation-group">
      <span class="navigation-title">{group.title}</span>
      <ul>{group.links.map((link) => (
        <li><a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
          {link.title}{path === link.href && <span class="navigation-dot" aria-hidden="true"></span>}
        </a></li>
      ))}</ul>
    </div>
  ))}
</nav>
