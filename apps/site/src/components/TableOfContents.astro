---
import type { TocItem } from '../lib/navigation';
interface Props { items: TocItem[]; sourceURL: string; }
const { items, sourceURL } = Astro.props;
---
<aside class="page-outline" aria-label="On this page">
  <div class="outline-inner">
    {items.length > 0 && <nav aria-label="Page sections">
      <span class="outline-title">On this page</span>
      <ul>{items.map((item) => <li class:list={{ 'outline-nested': item.depth === 3 }}>
        <a href={`#${item.id}`} data-outline-link>{item.text}</a>
      </li>)}</ul>
    </nav>}
    <div class="outline-source">
      <a href={sourceURL}>View page source <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/Principle-Driven/pdd/issues">Suggest a change <span aria-hidden="true">↗</span></a>
    </div>
    <div class="outline-note">
      <span class="outline-note-mark" aria-hidden="true">[P]</span>
      <p>Current rules.<br />Shared judgment.</p>
      <a href="/example">See PDD in practice <span aria-hidden="true">→</span></a>
    </div>
  </div>
</aside>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-outline-link]')];
  const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((section): section is HTMLElement => Boolean(section));
  if (sections.length > 0) {
    const setCurrent = (id: string) => links.forEach((link) => {
      if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    setCurrent(sections[0].id);
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) setCurrent(entry.target.id);
    }, { rootMargin: '-80px 0px -65% 0px', threshold: 0 });
    sections.forEach((section) => observer.observe(section));
  }
</script>
