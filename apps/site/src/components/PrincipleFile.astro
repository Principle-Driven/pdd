---
import { downloadFilename, markdownDownload, type Principle } from '../lib/principles';

interface Props { entry: Principle; }
const { entry } = Astro.props;
const filename = downloadFilename(entry);
const markdown = markdownDownload(entry);

// PDD-05@v1: The preview and download use the same principle definition.
---

<section class="principle-file" data-principle-file aria-label="Principle Markdown">
  <div class="file-actions">
    <a class="button" href={`/principles/${entry.id}.md`} download={filename}>Download .md <span aria-hidden="true">↓</span></a>
  </div>
  <pre class="file-markdown" tabindex="0" aria-label="Markdown file"><code data-markdown-source>{markdown}</code></pre>
</section>

<style>
  .principle-file { position: relative; margin-top: 20px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: var(--subtle); }
  .file-actions { position: absolute; top: 14px; right: 14px; z-index: 1; }
  .file-actions .button { opacity: 0.55; transition: opacity 150ms; }
  .file-actions .button:hover, .file-actions .button:focus-visible { opacity: 1; }
  .principle-file .file-markdown { margin: 0; padding: 23px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12px; line-height: 1.8; border: 0; border-radius: 0; background: transparent; }
  .file-markdown::before { content: ''; float: right; width: 128px; height: 38px; }
  @media (max-width: 600px) {
    .file-actions { top: 10px; right: 10px; }
    .file-actions .button { padding: 6px 9px; min-height: 34px; font-size: 11px; }
    .principle-file .file-markdown { padding: 16px; font-size: 11px; }
    .file-markdown::before { width: 116px; }
  }
</style>
