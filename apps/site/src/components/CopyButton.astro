<button class="copy-button" type="button" data-copy-button aria-label="Copy code">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M15 9V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h4" /></svg>
  <span data-copy-label>Copy</span>
  <span class="sr-only" role="status" data-copy-status></span>
</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-button]').forEach((button) => {
    let resetTimer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      const code = button.closest('.code-block')?.querySelector('pre code')?.textContent;
      const label = button.querySelector('[data-copy-label]');
      const status = button.querySelector('[data-copy-status]');
      if (!code || !label || !status) return;
      clearTimeout(resetTimer);
      try {
        await navigator.clipboard.writeText(code);
        label.textContent = 'Copied';
        status.textContent = 'Code copied to the clipboard.';
      } catch {
        label.textContent = 'Try again';
        status.textContent = 'Copy failed. Select the code to copy it.';
      }
      resetTimer = setTimeout(() => { label.textContent = 'Copy'; status.textContent = ''; }, 2000);
    });
  });
</script>
