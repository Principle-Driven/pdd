---
import type { NavigationGroup } from '../lib/navigation';
interface Props { groups: NavigationGroup[]; }
const { groups } = Astro.props;
const pages = groups.flatMap((group) => group.links).filter((link) => !link.href.includes('#'));
---
<button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="7" /><path d="m16 16 5 5" /></svg>
  <span>Search documentation...</span><kbd>⌘ K</kbd>
</button>
<dialog class="search-dialog" id="documentation-search" aria-label="Search documentation" data-pages={JSON.stringify(pages)}>
  <div class="search-input-row">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="7" /><path d="m16 16 5 5" /></svg>
    <label class="sr-only" for="documentation-search-input">Search documentation</label>
    <input id="documentation-search-input" type="search" placeholder="Find a guide, principle, or token..." autocomplete="off" />
    <button class="search-close" type="button" data-search-close aria-label="Close search">Esc</button>
  </div>
  <p class="search-status" role="status" data-search-status>Suggested pages</p>
  <div class="search-results" data-search-results></div>
  <div class="search-help"><span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span><span><kbd>↵</kbd> Open page</span></div>
</dialog>
<script>
  interface SearchPage { title: string; href: string; text?: string; }
  const dialog = document.querySelector<HTMLDialogElement>('#documentation-search');
  const input = document.querySelector<HTMLInputElement>('#documentation-search-input');
  const results = document.querySelector<HTMLDivElement>('[data-search-results]');
  const status = document.querySelector<HTMLParagraphElement>('[data-search-status]');
  const pages: SearchPage[] = JSON.parse(dialog?.dataset.pages ?? '[]');
  let loadPromise: Promise<void> | undefined;
  const showResults = () => {
    if (!results || !status) return;
    const query = input?.value.trim().toLowerCase() ?? '';
    const terms = query.split(/\s+/).filter(Boolean);
    const matches = pages.filter((page) => terms.every((term) => `${page.title} ${page.text ?? ''}`.toLowerCase().includes(term)))
      .sort((a, b) => Number(b.title.toLowerCase().includes(query)) - Number(a.title.toLowerCase().includes(query)))
      .slice(0, query ? 8 : 3);
    results.replaceChildren();
    status.textContent = query ? `${matches.length} ${matches.length === 1 ? 'result' : 'results'}` : 'Suggested pages';
    for (const page of matches) {
      const link = document.createElement('a');
      link.href = page.href;
      link.className = 'search-result';
      const title = document.createElement('strong');
      title.textContent = page.title;
      const detail = document.createElement('span');
      const matchAt = page.text?.toLowerCase().indexOf(terms[0] ?? '') ?? -1;
      const start = Math.max(0, matchAt - 45);
      detail.textContent = query && page.text ? `${start > 0 ? '…' : ''}${page.text.slice(start, start + 145)}…` : page.href === '/' ? 'Documentation / Introduction' : page.href;
      link.append(title, detail);
      results.append(link);
    }
    if (matches.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'search-empty';
      empty.textContent = 'No pages match. Try a principle name or token.';
      results.append(empty);
    }
  };
  const openSearch = async () => {
    if (!dialog || !input) return;
    if (!dialog.open) dialog.showModal();
    input.focus();
    showResults();
    if (!loadPromise) {
      if (status) status.textContent = 'The search index loads…';
      loadPromise = Promise.allSettled(pages.map(async (page) => {
        const response = await fetch(page.href);
        if (!response.ok) throw new Error('Page unavailable');
        const document = new DOMParser().parseFromString(await response.text(), 'text/html');
        page.text = document.querySelector('[data-doc-content]')?.textContent?.replace(/\s+/g, ' ').trim() ?? '';
      })).then((outcomes) => {
        showResults();
        if (outcomes.some((outcome) => outcome.status === 'rejected') && status) status.textContent += '. Some pages did not load.';
      });
    }
    await loadPromise;
  };
  document.querySelector('[data-search-open]')?.addEventListener('click', () => void openSearch());
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
  input?.addEventListener('input', showResults);
  dialog?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) dialog.close();
    if (event.target === dialog) {
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    }
  });
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      dialog.close();
      return;
    }
    const links = [...(results?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
    const index = links.findIndex((link) => link === document.activeElement);
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const direction = event.key === 'ArrowDown' ? 1 : -1;
      links[(index + direction + links.length) % links.length]?.focus();
    }
    if (event.key === 'Enter' && document.activeElement === input && links[0]) {
      event.preventDefault();
      links[0].click();
    }
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) dialog.close();
      else void openSearch();
    }
  });
</script>
