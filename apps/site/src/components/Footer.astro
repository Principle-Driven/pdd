---
import { siteConfig } from '../../site.config.mjs';
import type { DocLink } from '../lib/navigation';
interface Props { previous?: DocLink; next?: DocLink; }
const { previous, next } = Astro.props;
---
<footer class="doc-footer">
  {(previous || next) && <nav class="page-pagination" aria-label="Previous and next pages">
    <div>{previous && <a href={previous.href}><span>← Previous</span><strong>{previous.title}</strong></a>}</div>
    <div>{next && <a class="pagination-next" href={next.href}><span>Next →</span><strong>{next.title}</strong></a>}</div>
  </nav>}
  <div class="footer-meta"><span>Principle Driven Development</span><a href={siteConfig.licenseURL}>{siteConfig.license} License</a><a href={siteConfig.repository}>GitHub ↗</a></div>
</footer>
