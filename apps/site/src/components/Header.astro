---
import { siteConfig } from '../../site.config.mjs';

const path = Astro.url.pathname;
const links = [
  { href: '/method', label: 'Method' },
  { href: '/blueprint', label: 'Blueprint' },
  { href: '/principles', label: 'Principles' },
  { href: '/cli', label: 'CLI' },
];
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Principle Driven Development home">
      <span class="brand-mark">P</span>
      <span>PDD</span>
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="nav-actions">
      <a class="github" href={siteConfig.repository}>GitHub <span aria-hidden="true">↗</span></a>
      <a class="start" href="/blueprint">Start here <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>

<style>
  .site-header { position: relative; z-index: 10; }
  .nav-wrap { display: grid; min-height: 82px; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; width: max-content; align-items: center; gap: 0.65rem; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.12em; }
  .brand-mark { display: grid; width: 31px; height: 31px; place-items: center; border-radius: 50% 50% 50% 7px; color: var(--white); background: var(--forest); font-family: var(--serif); font-size: 1.1rem; letter-spacing: 0; }
  nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.3rem); }
  nav a { position: relative; color: var(--muted); font-size: 0.83rem; font-weight: 650; }
  nav a::after { position: absolute; right: 0; bottom: -0.55rem; left: 0; height: 2px; transform: scaleX(0); background: var(--forest); content: ''; transition: transform 160ms ease; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a:hover::after, nav a[aria-current='page']::after { transform: scaleX(1); }
  .nav-actions { display: flex; justify-self: end; align-items: center; gap: 1rem; }
  .github { color: var(--muted); font-size: 0.83rem; font-weight: 650; }
  .github:hover { color: var(--ink); }
  .start { font-size: 0.83rem; font-weight: 750; }
  @media (max-width: 650px) {
    .nav-wrap { min-height: 72px; grid-template-columns: auto 1fr; gap: 1rem; }
    .brand > span:last-child { display: none; }
    nav { justify-content: end; gap: 0.9rem; }
    nav a { font-size: 0.72rem; }
    .nav-actions { display: none; }
  }
</style>
