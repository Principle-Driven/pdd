---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byOrder, type Principle } from '../../lib/principles';

export async function getStaticPaths() {
  const entries = await getCollection('principles');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: Principle; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const principles = (await getCollection('principles')).sort(byOrder);
const currentIndex = principles.findIndex((item) => item.id === entry.id);
const next = principles[(currentIndex + 1) % principles.length];
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="principle-hero container">
      <a class="back" href="/principles">← All principles</a>
      <div class="meta"><span>{entry.data.token}</span><span>{entry.data.category}</span><span>{entry.data.version}</span></div>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <a class="button primary" href={`/principles/${entry.id}.md`} download>Download Markdown ↓</a>
    </header>
    <section class="outcome container" aria-label="Principle outcome">
      <div>
        <span>Benefit</span>
        <strong>{entry.data.benefit}</strong>
      </div>
      <div>
        <span>Problem it prevents</span>
        <p>{entry.data.prevents}</p>
      </div>
    </section>
    <div class="principle-body container">
      <aside>
        <div><span>Use when</span><p>{entry.data.useWhen}</p></div>
        <div><span>Tradeoff</span><p>{entry.data.tradeoff}</p></div>
        {entry.data.lineage && <div><span>Recognized as</span><p>{entry.data.lineage}</p></div>}
        {entry.data.reference && <div><span>Reference</span><p><a href={entry.data.reference}>Official standard ↗</a></p></div>}
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
  <a class="next-principle" href={`/principles/${next.id}`}>
    <span>Next principle · {next.data.token}</span>
    <strong>{next.data.title}</strong>
    <i aria-hidden="true">→</i>
  </a>
</BaseLayout>

<style>
  .principle-hero { padding: 3rem 0 clamp(4rem, 8vw, 7rem); }
  .back { display: inline-block; margin-bottom: clamp(4rem, 8vw, 7rem); color: var(--muted); font-size: 0.8rem; font-weight: 700; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .meta span { padding: 0.35rem 0.55rem; border: 1px solid var(--line); border-radius: 999px; color: var(--forest-light); font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; }
  h1 { max-width: 940px; margin: 2rem 0 1.5rem; font-family: var(--serif); font-size: clamp(3.8rem, 9vw, 8.5rem); font-weight: 400; letter-spacing: -0.06em; line-height: 0.9; }
  .principle-hero .lede { margin-bottom: 2rem; }
  .outcome { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .outcome > div { padding: clamp(1.5rem, 4vw, 3rem); }
  .outcome > div + div { border-left: 1px solid var(--line); }
  .outcome span { display: block; margin-bottom: 1.2rem; color: var(--forest-light); font-family: var(--mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .outcome strong { font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.6rem); font-weight: 400; letter-spacing: -0.025em; line-height: 1.2; }
  .outcome p { color: var(--muted); font-size: 1.02rem; }
  .principle-body { display: grid; grid-template-columns: 300px minmax(0, 760px); gap: clamp(3rem, 8vw, 8rem); justify-content: center; padding: clamp(4rem, 8vw, 7rem) 0 clamp(6rem, 12vw, 11rem); border-top: 1px solid var(--line); }
  aside { display: grid; gap: 1.6rem; align-content: start; }
  aside div { padding-bottom: 1.6rem; border-bottom: 1px solid var(--line); }
  aside span { font-family: var(--mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  aside p { margin-top: 0.6rem; color: var(--muted); font-size: 0.9rem; }
  aside a { border-bottom: 1px solid currentColor; color: var(--forest-light); }
  .next-principle { position: relative; display: grid; grid-template-columns: 1fr auto; padding: clamp(3rem, 7vw, 6rem) max(20px, calc((100vw - 1180px) / 2)); color: var(--white); background: var(--forest); }
  .next-principle span { grid-column: 1; color: #b4c3ba; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .next-principle strong { grid-column: 1; margin-top: 1rem; font-family: var(--serif); font-size: clamp(2.3rem, 5vw, 5rem); font-weight: 400; letter-spacing: -0.045em; }
  .next-principle i { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--signal); font-size: 3rem; font-style: normal; transition: transform 160ms ease; }
  .next-principle:hover i { transform: translateX(8px); }
  @media (max-width: 760px) { .outcome, .principle-body { grid-template-columns: 1fr; } .outcome > div + div { border-top: 1px solid var(--line); border-left: 0; } aside { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { aside { grid-template-columns: 1fr; } }
</style>
